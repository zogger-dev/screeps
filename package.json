{
  "name": "screeps",
  "version": "0.1.0",
  "private": true,
  "description": "Screeps AI",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "plan:rooms": "tsc -p tools/tsconfig.json && node tools/harness.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/lodash": "3.10.2",
    "@types/screeps": "^3.3.8",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
